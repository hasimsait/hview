{
  "name": "hview",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:state": "node scripts/run_tests.mjs",
    "test:colors:browser": "node scripts/check_surface_colors.mjs",
    "test:lighting:browser": "node scripts/check_night_lighting.mjs",
    "test:layers:browser": "node scripts/check_surface_layers.mjs",
    "dev": "vite",
    "build:viewer": "npx tsx scripts/build_standalone_viewer.ts",
    "build:sample-editor": "tsx scripts/build_sample_editor.ts",
    "build": "tsc && vite build && npx tsx scripts/build_standalone_viewer.ts",
    "preview": "vite preview",
    "test": "node scripts/test_all.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:types": "tsc -p tsconfig.tests.json",
    "test:workflows": "playwright test tests/e2e/workflows.spec.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "three": "^0.186.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "26.1.0",
    "postcss": "^8.5.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "tsx": "4.20.6",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "3.2.4"
  }
}
